# Sao chép file này thành ".env" (cùng thư mục với manage.py) rồi điền giá trị thật.
# ".env" không được đưa lên Git/host công khai — chỉ dùng trên server/PaaS của bạn.

SECRET_KEY=doi-thanh-chuoi-bi-mat-that-dai-ngau-nhien
DEBUG=False
ALLOWED_HOSTS=api-clb-cua-ban.vn,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://clb-cua-ban.vn

# Cách 1: dùng 1 biến duy nhất DATABASE_URL nếu nền tảng cấp sẵn (Vibe Hosting, Render...)
# DATABASE_URL=postgresql://user:password@host:5432/tendatabase

# Cách 2: khai báo rời từng biến (dùng khi tự cài PostgreSQL trên VPS)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=ttclub
DB_USER=ttclub_user
DB_PASSWORD=doi-mat-khau-that-manh-o-day
DB_HOST=localhost
DB_PORT=5432

# Khi muốn chạy tạm bằng SQLite (không cần cài PostgreSQL) lúc phát triển,
# đổi dòng dưới đây (bỏ dấu # ở đầu):
# DB_ENGINE=django.db.backends.sqlite3
